PORT=3000

# ── Ciclo (chatbot do Dashboard) ─────────────────────────────────────────
# Chave da API do LLM. NUNCA preencha a chave neste arquivo (.env.example vai
# para o GitHub): copie-o para ".env" e coloque a chave lá.
# Sem chave, o Ciclo funciona em "modo offline" (mesmas ferramentas e RAG,
# mas respostas montadas pelo código).
# Gemini: gere grátis em https://aistudio.google.com/apikey
CICLO_API_KEY=

# "gemini" = API nativa do Google Gemini (aceita as chaves novas "AQ.").
# "openai" = qualquer API no formato Chat Completions (OpenAI, Groq...);
#            nesse caso preencha também CICLO_BASE_URL.
CICLO_PROVIDER=gemini
CICLO_MODEL=gemini-2.5-flash
# CICLO_BASE_URL=

# Origem permitida no CORS (domínio do site). "*" libera tudo (só para dev).
CORS_ORIGIN=*
